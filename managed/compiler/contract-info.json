    {
      "name": "verifyWarranty",
      "impure": true,
      "privateWitnesses": []
    },
    {
      "name": "revokeWarranty",
      "impure": true,
      "privateWitnesses": [
        "manufacturerSigningKey"
      ]
    },
    {
      "name": "setManufacturerCommitment",
