      "privateWitnesses": [
        "participantSecretKey",
        "surveyProofNonce",
        "surveyResponseDataHash",
        "assessmentScoreValue"
      ]
    },
    {
      "name": "verifySurveySubmission",
      "impure": true,
      "privateWitnesses": []
    },
    {
      "name": "revokeSubmission",
