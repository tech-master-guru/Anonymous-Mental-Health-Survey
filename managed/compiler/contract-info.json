  "witnesses": [
    {
      "name": "participantSecretKey",
      "type": "Bytes<32>"
    },
    {
      "name": "surveyProofNonce",
      "type": "Bytes<32>"
    },
    {
      "name": "surveyResponseDataHash",
      "type": "Bytes<32>"
    },
    {
      "name": "assessmentScoreValue",
      "type": "Uint<32>"
    },
    {
      "name": "surveyorSigningKey",
      "type": "Bytes<32>"
    },
    {
      "name": "productSecretKey",
      "type": "Bytes<32>"
    },
    {
      "name": "warrantyProofNonce",
      "type": "Bytes<32>"
    },
    {
      "name": "purchaseInvoiceHash",
      "type": "Bytes<32>"
