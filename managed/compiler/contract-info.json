      ]
    },
    {
      "name": "setSurveyorCommitment",
      "impure": true,
      "privateWitnesses": [
        "surveyorSigningKey"
      ]
    },
    {
      "name": "resetSurveyCohort",
      "impure": true,
      "privateWitnesses": []
    },
    {
      "name": "incrementSession",
      "impure": true,
      "privateWitnesses": []
    },
    {
      "name": "claimWarranty",
      "impure": true,
